
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mon Jeu - Stratégie</title>

<!-- Leaflet : carte interactive -->
<link rel="stylesheet"
href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #101923;
    color: white;
}

.screen {
    display: none;
    min-height: 100vh;
}

.screen.active {
    display: flex;
}

/* ACCUEIL */

#home {
    justify-content: center;
    align-items: center;
    flex-direction: column;
    text-align: center;
    background:
        linear-gradient(#07111b99, #07111bcc),
        url("https://tile.openstreetmap.org/") center/cover,
        #152638;
    background-image:
        linear-gradient(#07111b99, #07111bcc),
        url("https://images.unsplash.com/photo-1524666041070-9fc1a7e8e7d2?auto=format&fit=crop&w=2000&q=85");
}

.logo {
    font-size: clamp(36px, 7vw, 75px);
    letter-spacing: 7px;
    font-weight: 900;
    text-shadow: 0 4px 15px black;
}

.subtitle {
    letter-spacing: 5px;
    color: #c5d8e8;
    margin-bottom: 50px;
}

.main-button {
    padding: 18px 65px;
    background: #c82d35;
    border: 2px solid #ed6269;
    border-radius: 15px;
    color: white;
    font-size: 25px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s;
}

.main-button:hover {
    background: #ed3e48;
    transform: scale(1.06);
}

/* CHOIX DES MODES */

#modeScreen {
    justify-content: center;
    align-items: center;
    flex-direction: column;
    background:
        linear-gradient(#07111bdd, #07111bdd),
        url("https://images.unsplash.com/photo-1524666041070-9fc1a7e8e7d2?auto=format&fit=crop&w=2000&q=85")
        center/cover;
}

.mode-title {
    font-size: 40px;
    margin-bottom: 45px;
}

.mode-container {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 30px;
    padding: 20px;
}

.mode-card {
    width: min(340px, 85vw);
    min-height: 240px;
    padding: 35px;
    border: 1px solid #71899c;
    border-radius: 18px;
    background: #152c40e8;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.mode-card h2 {
    font-size: 27px;
}

.mode-card p {
    color: #c3d1dc;
    line-height: 1.5;
}

.mode-card button {
    padding: 13px;
    border: 0;
    border-radius: 9px;
    color: white;
    background: #bd3038;
    font-size: 17px;
    cursor: pointer;
}

.back-button {
    margin: 20px;
    padding: 12px 25px;
    border: 1px solid white;
    background: #1a344b;
    color: white;
    border-radius: 8px;
    cursor: pointer;
}

/* CARTE */

#mapScreen {
    height: 100vh;
    min-height: 0;
    flex-direction: column;
}

#topbar {
    height: 65px;
    flex-shrink: 0;
    background: #111e2a;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    border-bottom: 1px solid #526578;
    gap: 10px;
}

#topbar h2 {
    font-size: 18px;
    letter-spacing: 2px;
}

#map {
    flex: 1;
    width: 100%;
    min-height: 0;
    background: #b5c8d0;
}

#loading {
    position: absolute;
    z-index: 1000;
    top: 80px;
    left: 50%;
    transform: translateX(-50%);
    background: #152638ee;
    padding: 13px 20px;
    border-radius: 8px;
    text-align: center;
    max-width: 90%;
}

#mapInfo {
    position: absolute;
    z-index: 500;
    bottom: 20px;
    left: 15px;
    background: #101d2be8;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 13px;
    pointer-events: none;
}

.leaflet-popup-content {
    color: #18232d;
    font-size: 14px;
}

@media(max-width: 600px) {
    #topbar h2 {
        font-size: 14px;
    }

    .mode-title {
        font-size: 30px;
    }
}
</style>
</head>

<body>

<!-- ACCUEIL -->
<section id="home" class="screen active">
    <div class="logo">MON JEU</div>
    <div class="subtitle">STRATÉGIE</div>
    <button class="main-button" onclick="showModes()">
        JOUER
    </button>
</section>

<!-- CHOIX DU MODE -->
<section id="modeScreen" class="screen">
    <h1 class="mode-title">CHOISIS TON MODE</h1>

    <div class="mode-container">

        <div class="mode-card">
            <div>
                <h2>JEU EN LIGNE</h2>
                <p>
                    Jeu multijoueur avec chacun son pays.
                    Affronte ou coopère avec d'autres joueurs.
                </p>
            </div>
            <button onclick="onlineMode()">
                CHOISIR
            </button>
        </div>

        <div class="mode-card">
            <div>
                <h2>SOLO</h2>
                <p>
                    Jeu seul dans plusieurs cartes
                    différentes au choix.
                </p>
            </div>
            <button onclick="startSolo()">
                CHOISIR
            </button>
        </div>

    </div>

    <button class="back-button" onclick="showHome()">
        RETOUR
    </button>
</section>

<!-- CARTE DU MONDE -->
<section id="mapScreen" class="screen">

    <div id="topbar">
        <button class="back-button"
        onclick="backToModes()">
            ← RETOUR
        </button>

        <h2>CARTE DU MONDE</h2>

        <span id="provinceCount">Chargement...</span>
    </div>

    <div id="map"></div>

    <div id="loading">
        Chargement des pays et des provinces...
    </div>

    <div id="mapInfo">
        Clique sur une province pour afficher ses informations.
    </div>

</section>

<!-- BIBLIOTHÈQUES -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@turf/turf@7/turf.min.js"></script>

<script>

// ---------------------------------
// NAVIGATION ENTRE LES ÉCRANS
// ---------------------------------

function showScreen(id) {
    document.querySelectorAll(".screen").forEach(screen => {
        screen.classList.remove("active");
    });

    document.getElementById(id).classList.add("active");
}

function showHome() {
    showScreen("home");
}

function showModes() {
    showScreen("modeScreen");
}

function backToModes() {
    showScreen("modeScreen");
}

function onlineMode() {
    alert("Le mode en ligne sera ajouté dans une prochaine version !");
}


// ---------------------------------
// VARIABLES DE LA CARTE
// ---------------------------------

let map = null;
let carteChargee = false;
let coucheProvinces = null;


// ---------------------------------
// LANCEMENT DU MODE SOLO
// ---------------------------------

function startSolo() {
    showScreen("mapScreen");

    if (!carteChargee) {
        setTimeout(initialiserCarte, 300);
    } else {
        setTimeout(() => map.invalidateSize(), 200);
    }
}


// ---------------------------------
// INITIALISATION DE LA CARTE
// ---------------------------------

async function initialiserCarte() {

    if (carteChargee) return;

    carteChargee = true;

    map = L.map("map", {
        minZoom: 2,
        maxZoom: 12,
        worldCopyJump: true
    }).setView([25, 10], 2);

    // Carte avec reliefs
    L.tileLayer(
        "https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png",
        {
            maxZoom: 17,
            attribution: 'Carte : <a href="https://opentopomap.org">OpenTopoMap</a>, données <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }
    ).addTo(map);

    try {
        // Récupération des pays
        const reponse = await fetch(
            "https://raw.githubusercontent.com/datasets/geo-countries/master/data/countries.geojson"
        );

        if (!reponse.ok) {
            throw new Error("Impossible de récupérer les pays.");
        }

        const data = await reponse.json();

        // Récupération des capitales
        const reponseCapitales = await fetch(
            "https://restcountries.com/v3.1/all?fields=name,cca3,capital,capitalInfo"
        );

        if (!reponseCapitales.ok) {
            throw new Error("Impossible de récupérer les capitales.");
        }

        const listeCapitales = await reponseCapitales.json();

        const capitales = new Map();

        listeCapitales.forEach(pays => {
            if (pays.cca3 && pays.capitalInfo?.latlng) {
                capitales.set(pays.cca3, {
                    nom: pays.capital?.[0] || "Capitale",
                    point: turf.point([
                        pays.capitalInfo.latlng[1],
                        pays.capitalInfo.latlng[0]
                    ])
                });
            }
        });

        const toutesLesProvinces = [];

        // ---------------------------------
        // TRAITEMENT DE CHAQUE PAYS
        // ---------------------------------

        for (const paysOriginal of data.features) {

            let pays = JSON.parse(JSON.stringify(paysOriginal));

            const proprietes = pays.properties || {};

            const nomPays =
                proprietes.ADMIN ||
                proprietes.name ||
                "Pays inconnu";

            const codePays =
                proprietes.ISO_A3 ||
                proprietes["ISO3166-1-Alpha-3"] ||
                proprietes.ADM0_A3;

            const capitale = capitales.get(codePays);

            // Retirer les petites îles détachées.
            // Les pays constitués d'un seul polygone restent conservés.
            if (pays.geometry.type === "MultiPolygon") {

                const polygones = pays.geometry.coordinates;

                const mesures = polygones.map((coordinates, index) => {
                    const feature = turf.polygon(coordinates);
                    return {
                        index,
                        surface: turf.area(feature)
                    };
                });

                const plusGrand = Math.max(
                    ...mesures.map(m => m.surface)
                );

                const conserves = mesures.filter(m =>
                    m.surface >= Math.max(
                        2000000000,
                        plusGrand * 0.01
                    )
                );

                const indices = conserves.map(m => m.index);

                if (indices.length > 0) {
                    pays.geometry.coordinates =
                        indices.map(i => polygones[i]);
                }
            }

            // Superficie du pays en kilomètres carrés
            const superficie =
                turf.area(pays) / 1000000;

            // 1 province par tranche de 50 000 km²
            // Maximum de 20 provinces
            const nombreProvinces = Math.max(
                1,
                Math.min(20, Math.ceil(superficie / 50000))
            );

            const boite = turf.bbox(pays);

            const largeur = boite[2] - boite[0];
            const hauteur = boite[3] - boite[1];

            const morceaux = [];

            // ---------------------------------
            // DÉCOUPAGE EN BANDES
            // ---------------------------------

            if (nombreProvinces === 1) {

                morceaux.push(pays);

            } else {

                const horizontal = largeur >= hauteur;

                for (let i = 0; i < nombreProvinces; i++) {

                    let boiteBande;

                    if (horizontal) {

                        const debut =
                            boite[0] + largeur * i / nombreProvinces;

                        const fin =
                            boite[0] + largeur * (i + 1) / nombreProvinces;

                        boiteBande = [
                            debut,
                            boite[1],
                            fin,
                            boite[3]
                        ];

                    } else {

                        const debut =
                            boite[1] + hauteur * i / nombreProvinces;

                        const fin =
                            boite[1] + hauteur * (i + 1) / nombreProvinces;

                        boiteBande = [
                            boite[0],
                            debut,
                            boite[2],
                            fin
                        ];
                    }

                    try {
                        const rectangle =
                            turf.bboxPolygon(boiteBande);

                        const intersection = turf.intersect(
                            turf.featureCollection([
                                pays,
                                rectangle
                            ])
                        );

                        if (intersection &&
                            turf.area(intersection) > 1000000) {
                            morceaux.push(intersection);
                        }

                    } catch (erreur) {
                        console.warn(
                            "Une province n'a pas pu être créée :",
                            nomPays
                        );
                    }
                }
            }

            if (morceaux.length === 0) {
                morceaux.push(pays);
            }

            // ---------------------------------
            // TROUVER LA PROVINCE DE LA CAPITALE
            // ---------------------------------

            let indexCapitale = -1;

            if (capitale) {

                for (let i = 0; i < morceaux.length; i++) {

                    try {
                        if (turf.booleanPointInPolygon(
                            capitale.point,
                            morceaux[i]
                        )) {
                            indexCapitale = i;
                            break;
                        }
                    } catch (erreur) {}
                }

                // Si la capitale n'est pas dans un morceau,
                // prendre celui dont le centre est le plus proche.
                if (indexCapitale === -1) {

                    let distanceMin = Infinity;

                    morceaux.forEach((province, index) => {

                        const distance = turf.distance(
                            capitale.point,
                            turf.centroid(province),
                            { units: "kilometers" }
                        );

                        if (distance < distanceMin) {
                            distanceMin = distance;
                            indexCapitale = index;
                        }
                    });
                }
            }

            // ---------------------------------
            // ATTRIBUTION DES NOMS
            // ---------------------------------

            morceaux.forEach((province, index) => {

                let nomProvince;

                if (index === indexCapitale) {
                    nomProvince = capitale.nom;
                } else {
                    nomProvince =
                        nomPays + " - Province " + (index + 1);
                }

                province.properties = {
                    nomPays: nomPays,
                    nomProvince: nomProvince
                };

                toutesLesProvinces.push(province);
            });
        }

        // ---------------------------------
        // AFFICHAGE DES PROVINCES
        // ---------------------------------

        function couleurPays(nom) {
            let hash = 0;

            for (let i = 0; i < nom.length; i++) {
                hash = nom.charCodeAt(i) + ((hash << 5) - hash);
            }

            const couleurs = [
                "#769bb0",
                "#9baf83",
                "#c5a36e",
                "#a88da7",
                "#7eaaa0",
                "#bd8d80",
                "#8796b8",
                "#b3a47b"
            ];

            return couleurs[Math.abs(hash) % couleurs.length];
        }

        coucheProvinces = L.geoJSON(toutesLesProvinces, {

            style: feature => ({
                color: "#263642",
                weight: 1,
                fillColor: couleurPays(
                    feature.properties.nomPays
                ),
                fillOpacity: 0.75
            }),

            onEachFeature: (feature, layer) => {

                const nom =
                    feature.properties.nomProvince;

                const pays =
                    feature.properties.nomPays;

                const contenu = document.createElement("div");

                const titre = document.createElement("strong");
                titre.textContent = nom;

                const ligne = document.createElement("div");
                ligne.textContent = "Pays : " + pays;

                contenu.appendChild(titre);
                contenu.appendChild(ligne);

                layer.bindPopup(contenu);

                layer.on("mouseover", function () {
                    this.setStyle({
                        weight: 3,
                        color: "#ffffff",
                        fillOpacity: 0.9
                    });
                });

                layer.on("mouseout", function () {
                    coucheProvinces.resetStyle(this);
                });
            }

        }).addTo(map);

        document.getElementById("provinceCount").textContent =
            toutesLesProvinces.length + " provinces";

        document.getElementById("loading").style.display = "none";

        map.fitWorld();

        setTimeout(() => map.invalidateSize(), 200);

        console.log(
            "Carte chargée :",
            toutesLesProvinces.length,
            "provinces"
        );

    } catch (erreur) {

        console.error(erreur);

        document.getElementById("loading").textContent =
            "Erreur de chargement de la carte. Vérifie ta connexion puis recharge la page.";

        carteChargee = false;
    }
}

</script>

</body>
</html>
